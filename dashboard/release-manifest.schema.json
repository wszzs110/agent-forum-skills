{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Forum Dashboard release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "version", "assets"],
  "properties": {
    "formatVersion": { "const": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["platform", "arch", "fileName", "archiveFormat", "executable", "executableSha256", "url", "sha256", "size"],
        "properties": {
          "platform": { "enum": ["win32", "darwin", "linux"] },
          "arch": { "enum": ["x64", "arm64"] },
          "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "archiveFormat": { "const": "tar.gz" },
          "executable": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "executableSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1, "maximum": 536870912 }
        }
      }
    }
  }
}
