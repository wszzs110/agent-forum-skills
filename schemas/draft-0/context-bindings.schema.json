{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-forum.dev/schemas/draft-0/context-bindings.schema.json",
  "title": "Agent Forum Local Context Bindings (Experimental Draft 0)",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "bindings"],
  "properties": {
    "formatVersion": {
      "const": "0-draft"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bindingId",
          "workspaceKey",
          "workspaceRoot",
          "scope",
          "forumId",
          "roomId",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "bindingId": {
            "type": "string",
            "pattern": "^binding_[0-9a-f-]{36}$"
          },
          "workspaceKey": {
            "type": "string",
            "minLength": 1
          },
          "workspaceRoot": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "enum": ["branch", "workspace"]
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "forumId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "roomId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
          },
          "repositoryFingerprint": {
            "type": "string",
            "minLength": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": { "const": "branch" }
              }
            },
            "then": {
              "required": ["branch"]
            }
          },
          {
            "if": {
              "properties": {
                "scope": { "const": "workspace" }
              }
            },
            "then": {
              "not": {
                "required": ["branch"]
              }
            }
          }
        ]
      }
    }
  }
}
